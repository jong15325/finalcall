# ─────────────────────────────────────────────────────────────────────────────
# FinalCall 환경변수 카탈로그 (.env.example) — FC-142
#
# 사용법(IntelliJ EnvFile 플러그인):
#   1) 이 파일을 `.env` 로 복사한다:  cp .env.example .env
#   2) IntelliJ > Run/Debug Configurations > (백엔드 실행 구성) > EnvFile 탭에서
#      "Enable EnvFile" 체크 후 이 프로젝트 루트의 `.env` 를 추가한다.
#   3) Active profiles = local 로 실행한다. (상세: docs/backend/references/env-file-setup.md)
#
# 규칙:
#   - 실 `.env` 는 .gitignore 로 커밋 차단된다(시크릿 포함). 이 `.env.example`(더미)만 추적한다.
#   - ★ 시크릿(비밀번호 등)은 절대 커밋하지 않는다. 아래 시크릿 항목은 빈 값/플레이스홀더로 둔다.
#   - 아래 값은 "로컬 안전 예시"다. 모든 키는 yml 에서 ${ENV:기본값} 형태로 기본값을 가지므로,
#     env 를 주입하지 않아도 로컬은 동일하게 동작한다(env 는 오버라이드 수단).
#   - dev/prod 는 DB_*·REDIS_*·JWT_SECRET·GATEWAY_INTERNAL_SECRET·APP_NAME·APP_DESCRIPTION·
#     MAIL_USERNAME·MAIL_PASSWORD 에 기본값이 없어(fail-fast) 반드시 실제 값을 주입해야 부팅된다.
#   - 목록/중첩 정책 테이블(bid.increment.tiers · fee.policy.tiers · resilience4j.*)은 env 로 빼지
#     않는다(env 는 목록 표현에 부적합·이미 Properties 로 관리). 값 변경은 application.yml 에서 한다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 데이터베이스(MySQL) ────────────────────────────────────────────────────────
# local 은 기본값이 있어 생략 가능. dev/prod 는 fail-fast(기본값 없음) → 필수 주입.
DB_URL=jdbc:mysql://localhost:3306/finalcall
DB_USERNAME=finalcall
DB_PASSWORD=finalcall

# ── Redis ─────────────────────────────────────────────────────────────────────
# local 기본값 존재. dev/prod fail-fast → 필수 주입.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT 인증 ──────────────────────────────────────────────────────────────────
# JWT_SECRET: ★ 시크릿. HS256 은 최소 256비트(32바이트) 필요. 아래는 로컬 전용 더미다.
#   dev/prod 는 반드시 자체 강한 시크릿을 env 로 주입한다(fail-fast).
JWT_SECRET=finalcall-local-dev-secret-key-please-change-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_EXP_MINUTES=30
JWT_REFRESH_EXP_DAYS=14

# ── 게이트웨이(직접접근 차단 공유비밀) ────────────────────────────────────────
# GATEWAY_INTERNAL_SECRET: ★ 시크릿. 게이트웨이(local) 기본값과 반드시 동일해야 경유가 성립.
#   아래는 로컬 전용 더미다. dev/prod fail-fast → 필수 주입.
GATEWAY_INTERNAL_SECRET=finalcall-local-gateway-shared-secret-change-me
# GATEWAY_INTERNAL_ENFORCED: 직접접근 차단 강제. 실 프로파일은 true. 통합 테스트만 false 오버라이드.
GATEWAY_INTERNAL_ENFORCED=true

# ── 메일(SMTP, 네이버 465 SSL) ────────────────────────────────────────────────
MAIL_HOST=smtp.naver.com
MAIL_PORT=465
# ★ 시크릿 — 빈 값 유지. 실발송 시에만 채운다(공통 yml 에 기본값 없음 → dev/prod fail-fast).
MAIL_USERNAME=
MAIL_PASSWORD=          # 네이버 앱 비밀번호(2단계 인증 시 앱 비밀번호 발급)
# 실발송 스위치. 로컬 기본 false(발송 스킵·코드 로그). 실발송은 true + 위 MAIL_USERNAME/PASSWORD 필요.
MAIL_SENDER_ENABLED=false

# ── 이메일 인증 정책(회원가입 코드 검증) ──────────────────────────────────────
EMAIL_VERIFY_CODE_LENGTH=6
EMAIL_VERIFY_TTL_SECONDS=600
EMAIL_VERIFY_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFY_MAX_ATTEMPTS=5

# ── 검색(Elasticsearch read-model) ────────────────────────────────────────────
ELASTICSEARCH_URIS=http://localhost:9200
SEARCH_INDEX_ALIAS=listings_search
# 부팅 시 전체 enrichment 재색인. 공통 기본 false, local 데모는 true.
SEARCH_REINDEX_ON_STARTUP=true
# MySQL↔ES 드리프트 화해 워커.
SEARCH_RECONCILIATION_ENABLED=true
SEARCH_RECONCILIATION_FIXED_DELAY_MS=300000
# 드리프트 시 자동 재색인 보정. 공통 기본 false, local 데모는 true.
SEARCH_RECONCILIATION_CORRECT_ON_DRIFT=true
SEARCH_RECONCILIATION_PRICE_BUCKET_SIZE=100000

# ── 워커(마감·만료 폴링) ──────────────────────────────────────────────────────
CLOSING_WORKER_ENABLED=true
CLOSING_WORKER_FIXED_DELAY_MS=2000
CLOSING_WORKER_BATCH_SIZE=200
SHOP_LISTING_DEFAULT_DURATION_DAYS=7
SHOP_EXPIRY_WORKER_ENABLED=true
SHOP_EXPIRY_WORKER_FIXED_DELAY_MS=60000
SHOP_EXPIRY_WORKER_BATCH_SIZE=200

# ── 앱/서버/추적 ──────────────────────────────────────────────────────────────
SERVER_PORT=8080
# APP_NAME/APP_DESCRIPTION: local 은 기본값 존재. dev/prod 는 relaxed binding·fail-fast(@NotBlank) → 필수 주입.
APP_NAME=finalcall
APP_DESCRIPTION=게임 아이템 경매 플랫폼
# 분산추적 샘플링 확률(local/dev 기본 1.0, prod 프로파일은 0.1 로 별도 오버라이드).
TRACING_SAMPLING_PROBABILITY=1.0

# ── 비즈니스/데모 ─────────────────────────────────────────────────────────────
# 캐시→게임머니 교환 비율(1 캐시 = rate 게임머니).
EXCHANGE_RATE=1000000
# 로컬 데모 시드 러너 on/off(local 전용).
DEMO_SEED_ENABLED=true
