# API base URL 오버라이드. 미설정 시 기본값 `/api/v1` (동일 오리진 프록시/게이트웨이 경유).
# 계약 [1.1] Base: /api/v1
VITE_API_BASE_URL=/api/v1
# 로컬 Vite 프록시의 API 대상. Docker 배포 도메인을 검증할 때만 해당 도메인으로 지정한다.
# 미설정 시 로컬 백엔드 http://localhost:8080 을 사용한다.
VITE_DEV_API_TARGET=

# 소셜 로그인 (FC-155 · 계약 §2 방식 B). provider 콘솔에서 발급한 client_id 를 넣으면
# 코드 변경 없이 카카오·네이버 버튼이 활성화된다. 미설정이면 버튼은 "준비 중" 비활성 상태다.
# client secret 은 백엔드 전용(프론트에 두지 않는다) — 여기엔 공개값(client_id·redirect_uri)만.
VITE_OAUTH_KAKAO_CLIENT_ID=
VITE_OAUTH_NAVER_CLIENT_ID=
# provider 에 등록하고 백엔드 화이트리스트와 일치시킬 콜백 URL. 미설정 시 `<현재 오리진>/oauth/callback`.
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
