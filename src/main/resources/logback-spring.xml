<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stage 4: 프로파일별 로그 출력 포맷.
  - 평문(local, default 등 dev/prod 가 아닌 프로파일): 콘솔 패턴 + traceId/spanId
  - JSON 한 줄(dev, prod): LogstashEncoder (timestamp/level/logger/thread/message + 모든 MDC)
  traceId/spanId 는 Micrometer 가 MDC 에 넣어준 값을 %X 로 참조한다(직접 넣지 않는다).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 평문 프로파일: dev/prod 가 아닌 모든 프로파일(local, 미지정 등) -->
    <springProfile name="!dev &amp; !prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-}/%X{spanId:-}] [%thread] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- JSON 프로파일: dev, prod (한 줄 JSON, 수집은 Stage G) -->
    <springProfile name="dev | prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <!-- LogstashEncoder 는 기본으로 timestamp/level/logger/thread/message 와 모든 MDC(traceId/spanId/httpMethod/requestUri 등)를 포함한다. -->
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
