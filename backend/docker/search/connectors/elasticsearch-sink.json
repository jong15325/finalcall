{
  "name": "finalcall-elasticsearch-sink",
  "config": {
    "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",
    "tasks.max": "1",

    "connection.url": "http://elasticsearch:9200",

    "//routing": "다중 소스 토픽(auction·shop)을 단일 인덱스 listings 로 라우팅한다(search-spec §12.4 통합 인덱스).",
    "topics.regex": "finalcall\\.finalcall\\.(auction|shop)",

    "//smt": "Debezium unwrap 은 DB 컬럼명(snake_case)을 발행하는데 listings 색인·질의 필드는 camelCase 다. rename SMT 로 정합시키고(item_name_snapshot→nameSnapshot·start_price→price·public_id→publicId 등), 소스 토픽별로 listingType 을 static 주입한다(predicate=TopicNameMatches). 그래야 CDC 문서가 nameSnapshot 매칭·listingType 필터에 걸린다(MAJOR-1 수정). 날짜(end_at·created_at)·코드축·레벨·스킬·gfExpireAt 은 앱 enrichment(ListingIndexer)가 ISO/정확값으로 채운다 — Debezium 시간 표현(에폭)과 date 매핑 충돌을 피하려 sink 에서 rename 하지 않는다.",
    "predicates": "isAuctionTopic,isShopTopic",
    "predicates.isAuctionTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.isAuctionTopic.pattern": "finalcall\\.finalcall\\.auction",
    "predicates.isShopTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.isShopTopic.pattern": "finalcall\\.finalcall\\.shop",

    "transforms": "rename,injectAuctionType,injectShopType,route",
    "transforms.rename.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.rename.renames": "item_name_snapshot:nameSnapshot,item_spec_snapshot:specSnapshot,start_price:price,public_id:publicId",
    "transforms.injectAuctionType.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.injectAuctionType.static.field": "listingType",
    "transforms.injectAuctionType.static.value": "AUCTION",
    "transforms.injectAuctionType.predicate": "isAuctionTopic",
    "transforms.injectShopType.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.injectShopType.static.field": "listingType",
    "transforms.injectShopType.static.value": "SHOP",
    "transforms.injectShopType.predicate": "isShopTopic",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "finalcall\\.finalcall\\.(auction|shop)",
    "transforms.route.replacement": "listings",

    "//idempotency": "at-least-once 전달 → 멱등 upsert 필수(§12.3). _id = 메시지 key = public_id(source SMT 승격). write.method=upsert 는 부분 갱신이라 CDC 는 스냅샷 필드만 갱신하고 앱 enrichment 가 채운 코드축을 덮어쓰지 않는다.",
    "key.ignore": "false",
    "schema.ignore": "true",
    "write.method": "upsert",
    "behavior.on.null.values": "delete",
    "behavior.on.malformed.documents": "warn",

    "batch.size": "200",
    "read.timeout.ms": "10000",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false"
  }
}
