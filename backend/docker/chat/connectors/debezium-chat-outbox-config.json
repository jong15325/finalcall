{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",

  "database.hostname": "mysql",
  "database.port": "3306",
  "database.user": "debezium",
  "database.password": "dbz",
  "database.server.id": "184055",

  "topic.prefix": "finalcall-chat-outbox",
  "database.include.list": "finalcall",
  "table.include.list": "finalcall.chat_event_outbox",
  "snapshot.mode": "initial",

  "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
  "schema.history.internal.kafka.topic": "schema-history.finalcall-chat-outbox",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",

  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id": "event_id",
  "transforms.outbox.table.field.event.key": "aggregate_id",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.field.event.timestamp": "occurred_at",
  "transforms.outbox.route.by.field": "aggregate_type",
  "transforms.outbox.route.topic.replacement": "finalcall.chat.events.v1",
  "transforms.outbox.route.tombstone.on.empty.payload": "false",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.table.fields.additional.placement": "event_id:envelope:eventId,event_type:envelope:eventType,event_version:envelope:eventVersion,occurred_at:envelope:occurredAt,aggregate_id:envelope:roomPublicId",

  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false"
}
