# docker compose --env-file .env.deploy -f compose.deploy.yml up -d --build
# 이 파일을 .env.deploy로 복사한 뒤 빈 값을 채운다. .env.deploy는 Git 추적 대상이 아니다.

DB_NAME=finalcall
